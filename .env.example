# Shared
DATABASE_URL=postgresql://edudocs:edudocs@localhost:5432/edudocs?schema=public
APP_URL=http://localhost:3000
API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# API authentication
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
CORS_ORIGIN=http://localhost:3000

# Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MAX_UPLOAD_BYTES=20971520
DEFAULT_USER_QUOTA_BYTES=10737418240

# M2 AI / local embedding
AI_PROVIDER_ORDER=openrouter
OPENROUTER_API_KEY=

AI_MODEL_PRIMARY=google/gemma-4-31b-it:free
AI_MODEL_FALLBACKS=google/gemma-4-26b-a4b-it:free,openrouter/free
ALLOW_PAID_MODELS=false
AI_MAX_RETRIES_PER_MODEL=2

EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384
HF_CACHE_DIR=.cache/huggingface
SEMANTIC_SEARCH_CANDIDATE_LIMIT=300
SEMANTIC_SEARCH_TOP_K=8
SEMANTIC_SEARCH_THRESHOLD=0.35
SUBJECT_CLASSIFICATION_THRESHOLD=0.55
SUBJECT_CLASSIFICATION_MIN_MARGIN=0.05
